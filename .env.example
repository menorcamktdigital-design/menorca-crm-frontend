# URL base de la API del CRM (n8n)
CRM_API_URL=https://n8n.menorca.pe/api/crm/v1
# Token Bearer de la API — solo server-side, nunca NEXT_PUBLIC
CRM_API_TOKEN=

# Meta Ads — opcional. Resuelve el ad_id del anuncio a partir del nombre que
# Sperant guarda en utm_content, para enlazar a Ads Manager. Sin estas
# variables el sync funciona igual, pero los anuncios quedan como texto plano
# en vez de enlazar al anuncio.
# Token de System User del Business Manager, con permiso ads_read.
META_ACCESS_TOKEN=
# ID numérico de la cuenta publicitaria, sin el prefijo "act_".
META_AD_ACCOUNT_ID=2175013586303175
# El mismo ID, expuesto al navegador para armar el link a Ads Manager. Sin el
# parámetro `act` Ads Manager abre la cuenta que el usuario tenga por defecto,
# que puede no ser la de Menorca, y muestra "Aún no creaste anuncios".
NEXT_PUBLIC_META_AD_ACCOUNT_ID=2175013586303175
